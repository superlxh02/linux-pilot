# 首次部署请替换以下口令；不要提交真实凭证。
POSTGRES_PASSWORD=replace-this-database-password
AGENT_TOKEN=replace-this-agent-token
VIEWER_TOKEN=replace-this-viewer-token
OPERATOR_TOKEN=replace-this-operator-token
# 注册与第三方登录。应用服务通过 PO__AUTH__... 覆盖 appliaction.yaml。
# PO_PUBLIC_URL 是实际访问 Web 控制台的根地址；OAuth 回调在此地址下。
PO_PUBLIC_URL=http://localhost:3000
# 内置管理员初始密码固定；正式部署请替换为你自己的长密码。
ADMIN_PASSWORD=admin-5a2c966a29f39ec1248ae6ba480ae765158d26fef745e139
PO_CODE_PEPPER=replace-this-with-a-random-32-byte-or-longer-secret
# 使用真实邮箱时，把以下 SMTP_* 全部替换为邮箱服务商提供的参数。
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=Linux-Pilot <no-reply@linux-pilot.local>
SMTP_USERNAME=
SMTP_PASSWORD=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 生产叠加文件的 gRPC TLS 证书目录；目录中放 server.crt 与 server.key。
GRPC_TLS_DIR=
# GitHub 回调：${PO_PUBLIC_URL}/api/v1/auth/oauth/github/callback
# Google 回调：${PO_PUBLIC_URL}/api/v1/auth/oauth/google/callback
