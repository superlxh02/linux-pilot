# 每台 Linux 主机复制为 worker/.env，令牌须与 Web 的 AGENT_TOKEN 一致。
PO_AGENT__SERVER_URL=http://127.0.0.1:50051
PO_AGENT__TOKEN=replace-this-agent-token
# 不设置 HOST_ID 时使用持久缓冲目录中的 ID；首次运行读取 /etc/machine-id。
PO_AGENT__SPOOL_DIR=/var/lib/linux-pilot-worker/spool
PO_AGENT__DETAIL_EVERY_SECS=5
# 中心服务启用 TLS 且使用自建 CA 时设置；同时在启动脚本环境中设置
# PILOT_WORKER_CA_DIR=/宿主机/证书目录，将其挂载到 /etc/linux-pilot。
# PO_AGENT__CA_CERT_PATH=/etc/linux-pilot/ca.pem
