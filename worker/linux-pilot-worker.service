[Unit]
Description=Linux-Pilot Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/linux-pilot-worker.env
ExecStart=/usr/local/bin/linux-pilot-worker
Restart=always
RestartSec=3
StateDirectory=linux-pilot-worker
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
